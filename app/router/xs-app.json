{
  "welcomeFile": "index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 60,
  "routes": [
    {
      "source": "^/odata/v4/mdmportal/recordApprovalDecision$",
      "target": "/odata/v4/mdmportal/recordApprovalDecision",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "localDir": "webapp",
      "authenticationType": "xsuaa",
      "cacheControl": "no-cache,must-revalidate"
    }
  ]
}