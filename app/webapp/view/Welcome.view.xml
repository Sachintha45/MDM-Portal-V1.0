<?xml version="1.0" encoding="UTF-8"?>
<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    controllerName="mdm.portal.controller.Welcome"
    displayBlock="true">

    <!-- Same page frame as the other screens: DynamicPage, title on the left,
         primary action on the right of the same line. -->
    <f:DynamicPage id="welcomePage" fitContent="true"
        toggleHeaderOnTitleClick="false" headerExpanded="true" preserveHeaderStateOnScroll="false"
        busy="{home>/busy}" busyIndicatorDelay="300"
        class="sapUiSizeCondensed sapMDMFieldMasterPage">

        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <VBox>
                        <Title text="{home>/greeting}" level="H2" wrapping="false"/>
                        <Text text="{home>/subtitle}" class="sapUiTinyMarginTop"/>
                    </VBox>
                </f:heading>
                <f:snappedHeading>
                    <Title text="{home>/greeting}" level="H3" wrapping="false"/>
                </f:snappedHeading>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <ScrollContainer height="100%" width="100%" vertical="true" horizontal="false" class="mdmListScroll">
            <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop sapUiSmallMarginBottom">

                <!-- What is going on, for this user only -->
                <FlexBox wrap="Wrap" class="sapUiSmallMarginBottom">
                    <GenericTile header="Awaiting my approval" subheader="{home>/kpi/pendingNote}"
                                 visible="{home>/isApprover}" press=".onKpiPress" class="sapUiTinyMargin mdmKpiTile">
                        <customData><core:CustomData key="route" value="myApprovals"/></customData>
                        <TileContent>
                            <NumericContent value="{home>/kpi/pending}" valueColor="Critical" withMargin="false"/>
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="My open requests" subheader="{home>/kpi/openNote}"
                                 press=".onKpiPress" class="sapUiTinyMargin mdmKpiTile">
                        <customData><core:CustomData key="route" value="myRequests"/></customData>
                        <TileContent>
                            <NumericContent value="{home>/kpi/open}" valueColor="Neutral" withMargin="false"/>
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="Returned / rejected" subheader="{home>/kpi/returnedNote}"
                                 press=".onKpiPress" class="sapUiTinyMargin mdmKpiTile">
                        <customData><core:CustomData key="route" value="myRequests"/></customData>
                        <TileContent>
                            <NumericContent value="{home>/kpi/returned}" valueColor="Error" withMargin="false"/>
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="Posted this week" subheader="{home>/kpi/postedNote}"
                                 press=".onKpiPress" class="sapUiTinyMargin mdmKpiTile">
                        <customData><core:CustomData key="route" value="myRequests"/></customData>
                        <TileContent>
                            <NumericContent value="{home>/kpi/posted}" valueColor="Good" withMargin="false"/>
                        </TileContent>
                    </GenericTile>
                </FlexBox>

                <FlexBox wrap="Wrap" alignItems="Start">
                    <Panel headerText="Needs your action" width="100%" class="sapUiTinyMargin">
                        <layoutData><FlexItemData growFactor="3" baseSize="28rem"/></layoutData>
                        <List items="{home>/actions}" noDataText="Nothing needs your action right now.">
                            <StandardListItem title="{home>title}" description="{home>description}"
                                              info="{home>tag}" infoState="{home>tagState}"
                                              type="Navigation" press=".onActionPress"/>
                        </List>
                    </Panel>

                    <Panel headerText="Recent activity" width="100%" class="sapUiTinyMargin">
                        <layoutData><FlexItemData growFactor="2" baseSize="20rem"/></layoutData>
                        <List items="{home>/activity}" noDataText="No recent activity.">
                            <StandardListItem title="{home>title}" description="{home>when}"
                                              type="Navigation" press=".onActivityPress"/>
                        </List>
                    </Panel>
                </FlexBox>

            </VBox>
            </ScrollContainer>
        </f:content>
    </f:DynamicPage>
</mvc:View>