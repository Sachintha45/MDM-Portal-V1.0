<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Dialog id="assignFieldsDialog"
            title="{dlg>/title}"
            contentWidth="60rem"
            contentHeight="34rem"
            resizable="true"
            draggable="true">

        <content>
            <VBox class="sapUiSmallMargin">
                <!-- Default status applied to newly selected fields -->
                <HBox alignItems="Center" class="sapUiTinyMarginBottom" wrap="Wrap"
                      visible="{dlg>/showStatus}">
                    <Label text="Default field status for selected fields:" class="sapUiTinyMarginEnd"/>
                    <Select id="dlgDefaultStatus" selectedKey="OPTIONAL">
                        <core:Item key="REQUIRED" text="Required"/>
                        <core:Item key="OPTIONAL" text="Optional"/>
                        <core:Item key="SUPPRESS" text="Suppress"/>
                    </Select>
                    <ToolbarSpacer/>
                </HBox>

                <SearchField id="dlgSearch" placeholder="Search field name or description…"
                             liveChange=".onDialogSearch" width="100%"
                             class="sapUiTinyMarginBottom"/>

                <Table id="dlgFieldsTable"
                       mode="MultiSelect"
                       growing="true" growingThreshold="100"
                       noDataText="No selectable fields found"
                       items="{dlg>/availableFields}"
                       fixedLayout="true" alternateRowColors="true">
                    <columns>
                        <Column width="20rem"><Text text="Description" wrapping="false"/></Column>
                        <Column width="11rem"><Text text="Field Name" wrapping="false"/></Column>
                        <Column><Text text="Main ▸ Sub Group" wrapping="false"/></Column>
                    </columns>
                    <items>
                        <!--
                            "selected" is bound (two-way) to a per-row flag on
                            the field object itself, not left to the Table's
                            own index/path-based selection tracking. Without
                            this, searching (which swaps /availableFields to a
                            new, shorter array on every keystroke) can leave a
                            checkbox showing "selected" on whatever field now
                            happens to land at the same list position as a
                            previously-checked one — i.e. fields the user never
                            clicked appearing pre-selected. Binding "selected"
                            to the object itself makes the checked state travel
                            with the field, immune to re-filtering/reindexing.
                        -->
                        <ColumnListItem selected="{dlg>selected}">
                            <cells>
                                <Text text="{dlg>description}" wrapping="false"/>
                                <Text text="{dlg>field_id}" wrapping="false"/>
                                <Text text="{dlg>group_path}" wrapping="false"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>

        <beginButton>
            <Button text="Add Selected" type="Emphasized" press=".onAssignFieldsConfirm"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onAssignFieldsCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>