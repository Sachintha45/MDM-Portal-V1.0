<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <!--
        ShellBar notifications popover.
        Section 1 "Waiting for your approval" = same data as the ShellBar badge
        (ApprovalHelper.getMyPendingApprovals) - clicking opens the approval step.
        Section 2 "Recent activity" = Notification log (assignment / decision events).
        No read/unread flag exists on Notification, so the log is informational only.
    -->
    <ResponsivePopover id="notificationsPopover"
                        title="Notifications"
                        placement="Bottom"
                        contentWidth="26rem"
                        contentHeight="30rem"
                        showHeader="true">
        <content>
            <List id="pendingList"
                  items="{notif>/pending}"
                  headerText="Waiting for your approval"
                  visible="{= ${notif>/pending}.length > 0 }"
                  class="sapUiNoContentPadding">
                <items>
                    <NotificationListItem
                        title="{notif>title}"
                        description="{notif>body}"
                        datetime="{notif>displayDate}"
                        priority="{notif>priority}"
                        showButtons="false"
                        showCloseButton="false"
                        press=".onPendingItemPress"/>
                </items>
            </List>
            <List id="notificationsList"
                  items="{notif>/items}"
                  headerText="Recent activity"
                  noDataText="{= ${notif>/pending}.length > 0 ? 'No activity yet' : 'You are all caught up' }"
                  growing="true"
                  growingThreshold="20"
                  class="sapUiNoContentPadding">
                <items>
                    <NotificationListItem
                        title="{notif>subject}"
                        description="{notif>body}"
                        datetime="{notif>displayDate}"
                        priority="{notif>priority}"
                        showButtons="false"
                        showCloseButton="false"
                        press=".onNotificationItemPress"/>
                </items>
            </List>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>