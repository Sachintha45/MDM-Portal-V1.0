{
  "name": "mdm-portal",
  "version": "1.0.0",
  "description": "MDM Portal CAP Application",
  "main": "srv/server.js",
  "scripts": {
    "start": "cds run",
    "dev": "cds watch --exclude db/*.sqlite*,db/*.db,*.log",
    "build": "cds build --production"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4.8.0",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap-cloud-sdk/resilience": "^4.8.0",
    "@sap/cds": "^9.9.1",
    "express": "^4.18.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "latest"
  },
  "cds": {
    "requires": {
      "[development]": {
        "db": "sqlite"
      },
      "workflow": {
        "kind": "rest",
        "credentials": {
          "destination": "MDM_Workflow_Dest"
        }
      }
    }
  }
}